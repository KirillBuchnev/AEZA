AEZA_ENVIRONMENT=development
AEZA_ADMIN_USERNAME=demo
AEZA_ADMIN_PASSWORD=local-demo-change-this-password
AEZA_ADMIN_CODEWORD=demo-codeword
AEZA_REGISTRATION_ENABLED=true
AEZA_RATE_LIMIT_SECRET=local-demo-rate-limit-secret-change-this-before-production
AEZA_TRUSTED_PROXY_IPS=10.233.40.10
AEZA_API_PORT=8001
AEZA_COOKIE_SECURE=false
AEZA_SESSION_DAYS=7
AEZA_METRICS_TOKEN=local-demo-metrics-token-change-this-before-production
AEZA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001
# PostgreSQL of the compose stack: reachable only inside the compose network. Change it before a shared run.
AEZA_POSTGRES_PASSWORD=aeza-local-only-change-me
# Optional SSO (OpenID Connect). Leave empty to use password login only.
AEZA_OIDC_ISSUER=
AEZA_OIDC_CLIENT_ID=
AEZA_OIDC_CLIENT_SECRET=
AEZA_OIDC_REDIRECT_URI=
AEZA_OIDC_AUTO_PROVISION=false
# Data loaded into an empty database: case (dataset of the case), showcase (case + scenario accounts S01-S14),
# demo (synthetic) or empty.
AEZA_SEED=showcase
